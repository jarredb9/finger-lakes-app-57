# Supabase Configuration (Local Stack Default: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Mapbox Access Token (Primary Map Engine)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your-mapbox-access-token

# Google APIs (Fallback Map & Server-side Places API v1 / Gemini Enrichment)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
GEMINI_API_KEY=your-gemini-api-key

# App Environment & Base URL
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# E2E & Testing Credentials
NEXT_PUBLIC_IS_E2E=false
IS_E2E=false
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=test-password-here
TEST_USER_2_EMAIL=test2@example.com
TEST_USER_2_PASSWORD=test2-password-here

# Optional Integrations
FIRECRAWL_API_KEY=
BADGR_API_KEY=
OPENAI_BASE_URL=
